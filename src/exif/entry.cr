module EXIF
  # A single EXIF tag together with its value.
  #
  # ```
  # entry = data[:exposure_time]
  # entry.name   # => "ExposureTime"
  # entry.title  # => "Exposure Time"
  # entry.format # => EXIF::Format::Rational
  # entry.value  # => EXIF::URational(1/250)
  # entry.to_s   # => "1/250 sec."
  # ```
  class Entry
    # Returns the `Data` this entry belongs to.
    getter data : Data

    @ptr : LibEXIF::EXIFEntry*

    # Whether the entry belongs to the GPS IFD (*gps*) is remembered, so that
    # the tag kind is still known once the entry gets removed from it.
    protected def initialize(@data : Data, @ptr : LibEXIF::EXIFEntry*, @gps : Bool = Entry.gps_parent?(ptr))
      LibEXIF.exif_entry_ref(@ptr)
    end

    # Returns `true` if the given entry is stored in the GPS IFD.
    protected def self.gps_parent?(ptr : LibEXIF::EXIFEntry*) : Bool
      parent = ptr.value.parent
      !parent.null? && LibEXIF.exif_content_get_ifd(parent).gps?
    end

    def finalize
      LibEXIF.exif_entry_unref(@ptr)
    end

    def to_unsafe : LibEXIF::EXIFEntry*
      @ptr
    end

    # Returns another wrapper of the same libexif entry.
    def dup : self
      self.class.new(data, @ptr, @gps)
    end

    # Yields the raw libexif entry, holding extra references to it (and to the
    # libexif data) meanwhile, see `Data#retain`.
    private def retain(& : LibEXIF::EXIFEntry* -> T) : T forall T
      ptr = @ptr
      LibEXIF.exif_entry_ref(ptr)
      begin
        data.retain { yield ptr }
      ensure
        LibEXIF.exif_entry_unref(ptr)
      end
    end

    # Returns `true` for entries of the GPS IFD (holding `GPSTag`s), even once removed from it.
    protected def gps? : Bool
      @gps
    end

    # Returns the IFD the entry is stored in, or `nil` if it was removed.
    def ifd? : IFD?
      parent = @ptr.value.parent
      LibEXIF.exif_content_get_ifd(parent) unless parent.null?
    end

    # Returns the IFD the entry is stored in.
    def ifd : IFD
      ifd? || raise Error.new("Entry is not attached to any IFD")
    end

    # Returns the entry tag (a `GPSTag` for entries stored in the GPS IFD).
    def tag : AnyTag
      tag = @ptr.value.tag
      gps? ? GPSTag.new(tag.value) : tag
    end

    # Returns the raw (numeric) tag, as used by libexif.
    protected def raw_tag : Tag
      @ptr.value.tag
    end

    # Returns the EXIF name of the entry tag (i.e. `"FNumber"`).
    def name : String
      tag_string { |ifd| raw_tag.name(ifd) } || "0x%04x" % raw_tag.value
    end

    # Returns the localized title of the entry tag (i.e. `"F-Number"`).
    def title : String?
      tag_string { |ifd| raw_tag.title(ifd) }
    end

    # Returns the localized description of the entry tag.
    def description : String?
      tag_string { |ifd| raw_tag.description(ifd) }
    end

    # Returns the string yielded for the IFD the entry is stored in, or else for any IFD
    # holding the same kind of tags (`nil`, see `Tag#name`), since `GPSTag`s overlap
    # numerically with other tags.
    private def tag_string(& : IFD? -> String?) : String?
      return yield IFD::GPS if gps?

      if ifd = ifd?
        string = yield ifd
      end
      string || yield nil
    end

    # Returns the support level of this entry within its IFD.
    def support_level : SupportLevel
      raw_tag.support_level(ifd, data.data_type)
    end

    # Returns the data format of the entry.
    def format : Format
      @ptr.value.format
    end

    # Returns the number of components (values) stored in the entry.
    def components : Int32
      @ptr.value.components.to_i
    end

    # Returns the size (in bytes) of the raw data.
    def bytesize : Int32
      @ptr.value.size.to_i
    end

    # Returns a copy of the raw entry data.
    def to_slice : Bytes
      retain do |ptr|
        data, size = ptr.value.data, ptr.value.size.to_i
        data.null? ? Bytes.empty : Slice.new(data, size).dup
      end
    end

    # Returns the decoded entry value, see `Value`.
    def value : Value
      retain { Codec.new(self, data.byte_order).decode }
    end

    # Encodes and stores the given *value*.
    #
    # Integers, floats and rationals may be given either as a scalar or an `Array`,
    # `String` is accepted by `Format::Ascii`, `Format::Undefined` and `Format::Byte` entries
    # (encoded as defined for `Tag::UserComment` and the `Tag::XPTitle`-like tags),
    # `Bytes` by `Format::Undefined`, `Format::Byte` and `Format::SByte` ones.
    #
    # Raises `ValueError` if the value can't be stored in the entry format, i.e. text
    # containing NUL characters (which would end it) in other than plain `Format::Undefined`
    # and `Format::Byte` entries, and `ArgumentError` for tags generated by libexif (see `Tag#managed?`).
    def value=(value)
      if (tag = self.tag).is_a?(Tag)
        tag.check_settable
      end
      retain { Codec.new(self, data.byte_order).encode(value) }
      # Only the maker note of the EXIF IFD is parsed by libexif
      data.maker_note_replaced if raw_tag.maker_note? && ifd? == IFD::EXIF
    end

    # Returns the value as a `String`.
    #
    # Raises `TypeCastError` if the value isn't a `String`.
    #
    # ```
    # data[:model].as_s # => "Canon PowerShot S70"
    # ```
    def as_s : String
      cast(String, &.as?(String))
    end

    # Returns the value as a `String`, or `nil` if it isn't one.
    def as_s? : String?
      value.as?(String)
    end

    # Returns the value as an `Int64`.
    #
    # Raises `TypeCastError` if the value isn't a single integer.
    #
    # ```
    # data[:orientation].as_i # => 6
    # ```
    def as_i : Int64
      cast(Int64, &.as?(Int64))
    end

    # Returns the value as an `Int64`, or `nil` if it isn't a single integer.
    def as_i? : Int64?
      value.as?(Int64)
    end

    # Returns the value as a `Float64`, converting integers and rationals
    # (undefined rationals are converted to `Float64::NAN`).
    #
    # Raises `TypeCastError` if the value isn't a single number.
    #
    # ```
    # data[:f_number].as_f # => 2.8
    # ```
    def as_f : Float64
      cast(Float64) { |value| float?(value) }
    end

    # Returns the value as a `Float64` (see `#as_f`), or `nil` if it isn't a single number.
    def as_f? : Float64?
      float?(value)
    end

    private def float?(value : Value) : Float64?
      case value
      when Float64, Int64, Rational then value.to_f
      end
    end

    # Returns the value as a rational.
    #
    # Raises `TypeCastError` if the value isn't a single rational.
    #
    # ```
    # data[:exposure_time].as_rational # => EXIF::URational(1/250)
    # ```
    def as_rational : URational | SRational
      cast(Rational, &.as?(URational | SRational))
    end

    # Returns the value as a rational, or `nil` if it isn't a single rational.
    def as_rational? : (URational | SRational)?
      value.as?(URational | SRational)
    end

    # Returns the value as `Bytes`.
    #
    # Raises `TypeCastError` if the value isn't `Bytes` (i.e. of `Format::Undefined`).
    #
    # ```
    # data[:exif_version].as_bytes # => Bytes[48, 50, 50, 48]
    # ```
    def as_bytes : Bytes
      cast(Bytes, &.as?(Bytes))
    end

    # Returns the value as `Bytes`, or `nil` if it isn't `Bytes`.
    def as_bytes? : Bytes?
      value.as?(Bytes)
    end

    # Returns all the components of the value, wrapping single ones in an `Array`.
    #
    # Raises `TypeCastError` if the value is `Bytes`, which has no components.
    #
    # ```
    # data[:gps_latitude].as_a # => [EXIF::URational(52/1), EXIF::URational(13/1), ...]
    # data[:make].as_a         # => ["Canon"]
    # ```
    def as_a : Array(Scalar)
      cast(Array) { |value| scalars?(value) }
    end

    # Returns all the components of the value (see `#as_a`), or `nil` if the value is `Bytes`.
    def as_a? : Array(Scalar)?
      scalars?(value)
    end

    private def scalars?(value : Value) : Array(Scalar)?
      case value
      when Bytes then nil
      when Array then value.map(&.as(Scalar))
      else            [value.as(Scalar)]
      end
    end

    # Yields the decoded value (decoded once), raising `TypeCastError`
    # if the block returns `nil`, i.e. for a value of another *type*.
    private def cast(type, & : Value -> T?) : T forall T
      value = self.value
      (yield value) || raise TypeCastError.new("Expected #{type} value of the #{name} entry, not #{value.class}")
    end

    # Returns the human-readable (localized) value of the entry, as formatted by libexif.
    #
    # NOTE: libexif can't format entries removed from their IFD (it needs their
    # byte order), nor most user comments (i.e. Unicode ones, or ones without
    # a character code), so these are formatted from their decoded `#value` instead,
    # without any trailing padding.
    def to_s(io : IO) : Nil
      if user_comment? && (text = value.as?(String))
        return io << text.rstrip
      end
      return format_value(io, value) unless ifd?

      maxlen = bytesize * format_ratio + 64
      if maxlen <= FORMAT_BUFFER_SIZE
        buffer = uninitialized UInt8[FORMAT_BUFFER_SIZE]
        format_into(io, buffer.to_slice)
      else
        format_into(io, Bytes.new(maxlen))
      end
    end

    # Size of the (stack allocated) buffer most values are formatted into.
    FORMAT_BUFFER_SIZE = 1024

    # Returns the (approximate) maximum number of characters per byte of data
    # libexif formats values of the entry format into.
    private def format_ratio : Int32
      case format
      when .ascii?, .undefined? then 1 # copied text, or a summary
      when .byte?, .s_byte?     then 6 # i.e. "0x00, "
      else                           4 # i.e. "65535, " for 2 bytes
      end
    end

    private def format_into(io : IO, buffer : Bytes) : Nil
      value = retain { |ptr| LibEXIF.exif_entry_get_value(ptr, buffer, buffer.size) }
      io.write_string(Slice.new(value, LibC.strlen(value))) unless value.null?
    end

    private def format_value(io : IO, value : Value) : Nil
      case value
      when Bytes then io << value.size << " bytes undefined data"
      when Array then value.join(io, ", ")
      else            io << value
      end
    end

    # :nodoc:
    #
    # Converts a Unicode `Tag::UserComment` to the other byte order (see `Data#byte_order=`).
    protected def swap_unicode_user_comment : Nil
      retain { Codec.new(self, data.byte_order).swap_unicode_user_comment }
    end

    private def user_comment? : Bool
      raw_tag.user_comment? && !gps?
    end

    # Fixes the format and components of the entry to bring it into specification.
    def fix : self
      retain { |ptr| LibEXIF.exif_entry_fix(ptr) }
      self
    end

    # Removes the entry from its IFD.
    def delete : self
      retain do |ptr|
        parent = ptr.value.parent
        LibEXIF.exif_content_remove_entry(parent, ptr) unless parent.null?
      end
      self
    end

    # Returns `true` if both wrap the same libexif entry.
    def ==(other : Entry) : Bool
      @ptr == other.to_unsafe
    end

    def hash(hasher)
      @ptr.address.hash(hasher)
    end

    def inspect(io : IO) : Nil
      io << "#<" << self.class.name << ' ' << name
      io << " ifd=" << ifd?
      io << " format=" << format
      io << " components=" << components
      io << " value=" << to_s.inspect
      io << '>'
    end

    # :nodoc:
    protected def raw : LibEXIF::EXIFEntry*
      @ptr
    end

    # Reads and writes entry values in the given byte order.
    private struct Codec
      # Character code prefixes used by `Tag::UserComment`.
      USER_COMMENT_ASCII   = "ASCII\0\0\0".to_slice
      USER_COMMENT_UNICODE = "UNICODE\0".to_slice
      USER_COMMENT_JIS     = "JIS\0\0\0\0\0".to_slice

      # All character code prefixes defined by the specification (the last one being undefined).
      USER_COMMENT_CHARSETS = {
        USER_COMMENT_ASCII, USER_COMMENT_UNICODE, USER_COMMENT_JIS, "\0\0\0\0\0\0\0\0".to_slice,
      }

      # Tags holding UTF-16LE strings, stored in `Format::Byte`.
      XP_TAGS = {Tag::XPTitle, Tag::XPComment, Tag::XPAuthor, Tag::XPKeywords, Tag::XPSubject}

      def initialize(@entry : Entry, @byte_order : ByteOrder)
      end

      private def raw
        @entry.raw.value
      end

      private def user_comment_tag? : Bool
        raw.tag.user_comment? && !@entry.gps?
      end

      private def xp_tag? : Bool
        raw.tag.in?(XP_TAGS) && !@entry.gps?
      end

      # --- Decoding ---

      def decode : Value
        data = raw.data
        # Entries without any data decode as empty values of their format
        bytes = data.null? ? Bytes.empty : Slice.new(data, raw.size.to_i)
        decode_text(bytes) || decode_numbers(bytes) || bytes.dup
      end

      # Decodes textual formats and tags, returning `nil` for other ones.
      private def decode_text(bytes : Bytes) : String?
        case
        when user_comment_tag? && (raw.format.undefined? || (raw.format.ascii? && user_comment_charset?(bytes)))
          # Stored as `Format::Ascii` by some writers, against the specification
          decode_user_comment(bytes)
        when raw.format.ascii?
          decode_string(bytes[0, bytes.index(0_u8) || bytes.size])
        when xp_tag? && raw.format.byte?
          decode_utf16(bytes, IO::ByteFormat::LittleEndian)
        end
      end

      # Decodes numeric formats, returning `nil` for other ones.
      private def decode_numbers(bytes : Bytes) : Value?
        format = raw.format
        return unless format.in?(NUMERIC_FORMATS)

        size = format.bytesize
        count = Math.min(raw.components.to_i, bytes.size // size)
        p = bytes.to_unsafe

        case format
        when .rational?
          collapse Array(URational).new(count) { |i| URational.from(LibEXIF.exif_get_rational(p + i * size, @byte_order)) }
        when .s_rational?
          collapse Array(SRational).new(count) { |i| SRational.from(LibEXIF.exif_get_srational(p + i * size, @byte_order)) }
        when .float?, .double?
          collapse Array(Float64).new(count) { |i| read_float(bytes[i * size, size]) }
        else
          collapse Array(Int64).new(count) { |i| read_int(p + i * size) }
        end
      end

      NUMERIC_FORMATS = {
        Format::Byte, Format::SByte, Format::Short, Format::SShort, Format::Long, Format::SLong,
        Format::Rational, Format::SRational, Format::Float, Format::Double,
      }

      private def collapse(values : Array(T)) : Value forall T
        values.size == 1 ? values.first : values
      end

      # Decodes text as UTF-8, falling back to ISO-8859-1 (commonly used by cameras).
      private def decode_string(bytes : Bytes) : String
        string = String.new(bytes)
        string.valid_encoding? ? string : String.new(bytes, "ISO-8859-1")
      end

      # Decodes a `Tag::UserComment`, keeping trailing spaces (padding used by some writers,
      # see `Entry#to_s`), or returns `nil` for JIS text, which isn't supported
      # (so that it's decoded as `Bytes` rather than misdecoded).
      private def decode_user_comment(bytes : Bytes) : String?
        # Without a character code (against the specification), all of the data is taken
        # as text, as libexif does; except for a NUL byte followed by rubbish (written i.e.
        # by Canon ZoomBrowser), which libexif takes as the undefined character code
        unless user_comment_charset?(bytes) || (bytes.size >= 8 && bytes[0].zero?)
          return decode_string(bytes).rstrip('\0')
        end

        charset, text = bytes[0, 8], bytes[8..]
        case charset
        when USER_COMMENT_UNICODE then decode_unicode_user_comment(text)
        when USER_COMMENT_JIS     then nil
        else
          # Not NUL-terminated, but padded with NUL characters by some writers
          decode_string(text).rstrip('\0')
        end
      end

      # Decodes UTF-16 text in the byte order of the data, unless it starts with
      # a byte order mark (some writers use UTF-16LE regardless of the data byte order).
      # Converts a Unicode `Tag::UserComment` without a byte order mark to the other
      # byte order, since it's stored in the byte order of the data.
      def swap_unicode_user_comment : Nil
        return unless unicode_user_comment?

        bytes = @entry.to_slice
        text = bytes + USER_COMMENT_UNICODE.size
        return if text[0, 2]?.in?(Bytes[0xFF, 0xFE], Bytes[0xFE, 0xFF])

        (text.size // 2).times { |i| text.swap(i * 2, i * 2 + 1) }
        commit(raw.format, bytes, bytes.size)
      end

      # Returns `true` for a `Tag::UserComment` holding UTF-16 text.
      def unicode_user_comment? : Bool
        return false unless user_comment_tag? && raw.format.in?(Format::Undefined, Format::Ascii)

        data = raw.data
        !data.null? && raw.size >= USER_COMMENT_UNICODE.size &&
          Slice.new(data, USER_COMMENT_UNICODE.size) == USER_COMMENT_UNICODE
      end

      private def user_comment_charset?(bytes : Bytes) : Bool
        bytes[0, USER_COMMENT_ASCII.size]?.in?(USER_COMMENT_CHARSETS)
      end

      private def decode_unicode_user_comment(bytes : Bytes) : String
        case bytes[0, 2]?
        when Bytes[0xFF, 0xFE] then decode_utf16(bytes[2..], IO::ByteFormat::LittleEndian)
        when Bytes[0xFE, 0xFF] then decode_utf16(bytes[2..], IO::ByteFormat::BigEndian)
        else                        decode_utf16(bytes, @byte_order.byte_format)
        end
      end

      private def decode_utf16(bytes : Bytes, format : IO::ByteFormat) : String
        units = Slice(UInt16).new(bytes.size // 2) do |i|
          format.decode(UInt16, bytes[i * 2, 2])
        end
        if nul = units.index(0_u16)
          units = units[0, nul]
        end
        String.from_utf16(units)
      end

      private def read_int(p : UInt8*) : Int64
        case raw.format
        when .byte?    then p.value.to_i64
        when .s_byte?  then p.value.to_i8!.to_i64
        when .short?   then LibEXIF.exif_get_short(p, @byte_order).to_i64
        when .s_short? then LibEXIF.exif_get_sshort(p, @byte_order).to_i64
        when .long?    then LibEXIF.exif_get_long(p, @byte_order).to_i64
        else                LibEXIF.exif_get_slong(p, @byte_order).to_i64
        end
      end

      private def read_float(bytes : Bytes) : Float64
        format = @byte_order.byte_format
        raw.format.float? ? format.decode(Float32, bytes).to_f64 : format.decode(Float64, bytes)
      end

      # --- Encoding ---

      # Encodes the *value* and stores it in the entry.
      #
      # The value is fully serialized before the entry is modified, so that
      # the entry is left intact if the value can't be stored.
      def encode(value) : Nil
        format, bytes, components = serialize(value)
        commit(format, bytes, components)
      end

      private def serialize(value : String) : {Format, Bytes, Int32}
        if user_comment_tag?
          check_text(value)
          bytes =
            if value.ascii_only?
              USER_COMMENT_ASCII + value.to_slice
            else
              USER_COMMENT_UNICODE + encode_utf16(value, @byte_order.byte_format)
            end
          return {Format::Undefined, bytes, bytes.size}
        end
        if xp_tag?
          check_text(value)
          bytes = encode_utf16(value, IO::ByteFormat::LittleEndian) + Bytes.new(2)
          return {Format::Byte, bytes, bytes.size}
        end

        case format = target_format(value)
        when .ascii?
          check_text(value)
          bytes = value.to_slice + Bytes.new(1)
          {format, bytes, bytes.size}
        when .undefined?, .byte?
          {format, value.to_slice.dup, value.bytesize}
        else
          mismatch!(value, format)
        end
      end

      # Raises `ValueError` if the text contains NUL characters, which end (or pad) the decoded text.
      private def check_text(value : String) : Nil
        raise ValueError.new("Cannot store text containing NUL characters") if value.includes?('\0')
      end

      private def serialize(value : Bytes) : {Format, Bytes, Int32}
        format = target_format(value)
        mismatch!(value, format) unless format.undefined? || format.byte? || format.s_byte?
        {format, value.dup, value.size}
      end

      private def serialize(value : Int | Float | Rational) : {Format, Bytes, Int32}
        serialize({value})
      end

      private def serialize(values : Indexable) : {Format, Bytes, Int32}
        raise ValueError.new("Cannot store an empty array") if values.empty?

        format = numeric_format(values)
        format = Format::Long if format.short? && promote_to_long?(values)

        size = format.bytesize
        bytes = Bytes.new(values.size * size)
        values.each_with_index do |value, i|
          write(bytes.to_unsafe + i * size, format, value)
        end
        {format, bytes, values.size}
      end

      private def serialize(value) : NoReturn
        mismatch!(value, raw.format)
      end

      # Returns `true` if any of the *values* doesn't fit into a `Format::Short`
      # entry of a tag which can be stored as `Format::Long` as well.
      private def promote_to_long?(values : Indexable) : Bool
        return false if @entry.gps? || !raw.tag.short_or_long?

        values.any? do |value|
          case value
          when Int, Float, Rational
            value.to_f > UInt16::MAX
          else
            false
          end
        end
      end

      private def write(p : UInt8*, format : Format, value) : NoReturn
        mismatch!(value, format)
      end

      private def write(p : UInt8*, format : Format, value : Int) : Nil
        case format
        when .rational?, .s_rational?, .float?, .double?
          write(p, format, value.to_f64)
        else
          write_int(p, format, value)
        end
      rescue OverflowError
        out_of_range!(value, format)
      end

      private def write_int(p : UInt8*, format : Format, value : Int) : Nil
        case format
        when .byte?, .undefined? then p.value = value.to_u8
        when .s_byte?            then p.value = value.to_i8.to_u8!
        when .short?             then LibEXIF.exif_set_short(p, @byte_order, value.to_u16)
        when .s_short?           then LibEXIF.exif_set_sshort(p, @byte_order, value.to_i16)
        when .long?              then LibEXIF.exif_set_long(p, @byte_order, value.to_u32)
        when .s_long?            then LibEXIF.exif_set_slong(p, @byte_order, value.to_i32)
        else                          mismatch!(value, format)
        end
      end

      private def write(p : UInt8*, format : Format, value : Float) : Nil
        case format
        when .float?      then @byte_order.byte_format.encode(value.to_f32, Slice.new(p, 4))
        when .double?     then @byte_order.byte_format.encode(value.to_f64, Slice.new(p, 8))
        when .rational?   then write(p, format, URational.new(value))
        when .s_rational? then write(p, format, SRational.new(value))
        else
          raise ValueError.new("Cannot store a float in an entry of #{format} format") unless value == value.round
          write_int(p, format, value.to_i64)
        end
      rescue OverflowError
        out_of_range!(value, format)
      end

      private def write(p : UInt8*, format : Format, value : Rational) : Nil
        case format
        when .rational?   then LibEXIF.exif_set_rational(p, @byte_order, URational.new(value).to_lib)
        when .s_rational? then LibEXIF.exif_set_srational(p, @byte_order, SRational.new(value).to_lib)
        else                   write(p, format, value.to_f)
        end
      rescue OverflowError
        out_of_range!(value, format)
      end

      private def encode_utf16(value : String, format : IO::ByteFormat) : Bytes
        units = value.to_utf16
        bytes = Bytes.new(units.size * 2)
        units.each_with_index do |unit, i|
          format.encode(unit, bytes[i * 2, 2])
        end
        bytes
      end

      # Returns the entry format, or one inferred from the *value*
      # when the entry has none yet (i.e. for tags unknown to libexif).
      private def target_format(value : String | Bytes) : Format
        format = raw.format
        return format if Format.valid?(format)

        value.is_a?(String) ? Format::Ascii : Format::Undefined
      end

      # Returns the entry format, or one inferred from all the *values*
      # when the entry has none yet (i.e. for tags unknown to libexif):
      # integers are stored as `Format::Long`, other numbers as `Format::Rational`,
      # using the signed variants if any of the values is negative (or is a `SRational`,
      # unless the other values don't fit `Format::SRational`).
      private def numeric_format(values : Indexable) : Format
        format = raw.format
        return format if Format.valid?(format)

        signed, signed_rationals, integers = false, false, true
        values.each do |value|
          case value
          when Int       then signed ||= value.negative?
          when Float     then signed ||= value.negative?; integers = false
          when SRational then signed ||= value.numerator.negative? || value.denominator.negative?; signed_rationals, integers = true, false
          when URational then integers = false
          else                mismatch!(values, format)
          end
        end
        return signed ? Format::SLong : Format::Long if integers

        # Signed rationals are kept as such, unless other (non-negative) values don't fit their range
        signed ||= signed_rationals && values.all? { |value| fits_s_rational?(value) }
        signed ? Format::SRational : Format::Rational
      end

      private def fits_s_rational?(value) : Bool
        case value
        when SRational  then true
        when URational  then value.numerator <= Int32::MAX && value.denominator <= Int32::MAX
        when Int, Float then value <= Int32::MAX
        else                 false
        end
      end

      # Replaces the entry data with *bytes*.
      private def commit(format : Format, bytes : Bytes, components : Int) : Nil
        data = Pointer(UInt8).null
        unless bytes.empty?
          data = EXIF.alloc(bytes.size)
          data.copy_from(bytes.to_unsafe, bytes.size)
        end
        EXIF.free(raw.data)

        entry = @entry.raw
        entry.value.format = format
        entry.value.data = data
        entry.value.size = bytes.size.to_u32
        entry.value.components = LibC::ULong.new(components)
      end

      private def mismatch!(value, format : Format) : NoReturn
        raise ValueError.new("Cannot store #{value.class} in an entry of #{format} format")
      end

      private def out_of_range!(value, format : Format) : NoReturn
        raise ValueError.new("Value #{value} out of range for format #{format}")
      end
    end
  end
end
