module EXIF
  # EXIF tag, i.e. an identifier of an `Entry`.
  #
  # NOTE: GPS tags reuse numeric values of other tags, so they live
  # in a separate enum, see `GPSTag`.
  alias Tag = LibEXIF::EXIFTag

  # EXIF tag found in the GPS `IFD`.
  alias GPSTag = LibEXIF::EXIFGPSTag

  # Either kind of tag.
  alias AnyTag = Tag | GPSTag

  # Formats of tags which libexif doesn't initialize with a default value,
  # as defined by the EXIF 2.32 and TIFF 6.0 (TIFF/EP) specifications.
  TAG_FORMATS = {
    # IFD 0
    Tag::NewSubfileType      => Format::Long,
    Tag::FillOrder           => Format::Short,
    Tag::DocumentName        => Format::Ascii,
    Tag::StripOffsets        => Format::Long,
    Tag::RowsPerStrip        => Format::Long,
    Tag::StripByteCounts     => Format::Long,
    Tag::TransferFunction    => Format::Short,
    Tag::SubIFDs             => Format::Long,
    Tag::TransferRange       => Format::Short,
    Tag::JPEGProc            => Format::Short,
    Tag::YCbCrCoefficients   => Format::Rational,
    Tag::XMLPacket           => Format::Byte,
    Tag::CFARepeatPatternDim => Format::Short,
    Tag::CFAPattern          => Format::Byte,
    Tag::BatteryLevel        => Format::Rational,
    Tag::IPTCNAA             => Format::Undefined,
    Tag::ImageResources      => Format::Undefined,
    Tag::InterColorProfile   => Format::Undefined,
    Tag::TimeZoneOffset      => Format::SShort,
    Tag::TIFFEPStandardID    => Format::Byte,
    Tag::XPTitle             => Format::Byte,
    Tag::XPComment           => Format::Byte,
    Tag::XPAuthor            => Format::Byte,
    Tag::XPKeywords          => Format::Byte,
    Tag::XPSubject           => Format::Byte,
    Tag::PrintImageMatching  => Format::Undefined,
    Tag::Padding             => Format::Undefined,
    # EXIF IFD
    Tag::SpectralSensitivity                 => Format::Ascii,
    Tag::OECF                                => Format::Undefined,
    Tag::StandardOutputSensitivity           => Format::Long,
    Tag::RecommendedExposureIndex            => Format::Long,
    Tag::ISOSpeed                            => Format::Long,
    Tag::ISOSpeedLatitudeYYY                 => Format::Long,
    Tag::ISOSpeedLatitudeZZZ                 => Format::Long,
    Tag::OffsetTime                          => Format::Ascii,
    Tag::OffsetTimeOriginal                  => Format::Ascii,
    Tag::OffsetTimeDigitized                 => Format::Ascii,
    Tag::SubjectArea                         => Format::Short,
    Tag::MakerNote                           => Format::Undefined,
    Tag::UserComment                         => Format::Undefined,
    Tag::SubSecTime                          => Format::Ascii,
    Tag::SubSecTimeOriginal                  => Format::Ascii,
    Tag::SubSecTimeDigitized                 => Format::Ascii,
    Tag::RelatedSoundFile                    => Format::Ascii,
    Tag::SpatialFrequencyResponse            => Format::Undefined,
    Tag::NewCFAPattern                       => Format::Undefined,
    Tag::DeviceSettingDescription            => Format::Undefined,
    Tag::ImageUniqueID                       => Format::Ascii,
    Tag::CameraOwnerName                     => Format::Ascii,
    Tag::BodySerialNumber                    => Format::Ascii,
    Tag::LensSpecification                   => Format::Rational,
    Tag::LensMake                            => Format::Ascii,
    Tag::LensModel                           => Format::Ascii,
    Tag::LensSerialNumber                    => Format::Ascii,
    Tag::CompositeImage                      => Format::Short,
    Tag::SourceImageNumberOfCompositeImage   => Format::Short,
    Tag::SourceExposureTimesOfCompositeImage => Format::Undefined,
    Tag::Gamma                               => Format::Rational,
    # Interoperability IFD
    Tag::InteroperabilityIndex   => Format::Ascii,
    Tag::InteroperabilityVersion => Format::Undefined,
    Tag::RelatedImageFileFormat  => Format::Ascii,
    Tag::RelatedImageWidth       => Format::Long,
    Tag::RelatedImageLength      => Format::Long,
  }

  # :ditto:
  GPS_TAG_FORMATS = {
    GPSTag::GPSProcessingMethod  => Format::Undefined,
    GPSTag::GPSAreaInformation   => Format::Undefined,
    GPSTag::GPSHPositioningError => Format::Rational,
  }

  # :nodoc:
  #
  # Returns the GPS tags indexed by their EXIF names.
  class_getter gps_tags_by_name : Hash(String, GPSTag) do
    GPSTag.values.each_with_object({} of String => GPSTag) do |tag, tags|
      tag.name.try { |name| tags[name] = tag }
    end
  end

  # Tags pointing to other parts of the EXIF data, which are generated by
  # libexif when saving it (the thumbnail is set via `Data#thumbnail=`).
  MANAGED_TAGS = {
    Tag::JPEGInterchangeFormat,
    Tag::JPEGInterchangeFormatLength,
    Tag::EXIFIfdPointer,
    Tag::GPSInfoIfdPointer,
    Tag::InteroperabilityIfdPointer,
  }

  # Tags which can be stored either as `Format::Short` or `Format::Long`.
  SHORT_OR_LONG_TAGS = {
    Tag::ImageWidth,
    Tag::ImageLength,
    Tag::StripOffsets,
    Tag::RowsPerStrip,
    Tag::StripByteCounts,
    Tag::PixelXDimension,
    Tag::PixelYDimension,
    Tag::RelatedImageWidth,
    Tag::RelatedImageLength,
  }

  # IFDs describing the primary image, in which (non-GPS) `Tag`s are looked up,
  # in order of priority. `IFD::One`, describing the thumbnail, is left out.
  TAG_LOOKUP_IFDS = {IFD::Zero, IFD::EXIF, IFD::Interoperability}
end

enum LibEXIF::EXIFTag
  # Returns the tag with the given EXIF *name* (i.e. `"FNumber"`), or `nil`.
  #
  # NOTE: Names of GPS tags return `nil`, use `GPSTag.from_name?` instead.
  def self.from_name?(name : String) : self?
    tag = LibEXIF.exif_tag_from_name(name)
    # libexif resolves GPS tag names too, which overlap numerically with other tags
    tag unless tag.value.zero? || LibEXIF::EXIFGPSTag.from_name?(name)
  end

  # Returns the tag with the given EXIF *name* (i.e. `"FNumber"`).
  def self.from_name(name : String) : self
    from_name?(name) || raise ArgumentError.new("Unknown EXIF tag: #{name.inspect}")
  end

  # Returns the EXIF name of the tag (i.e. `"FNumber"`).
  def name(ifd : LibEXIF::EXIFIfd? = nil) : String?
    ::EXIF.string? \
      ifd ? LibEXIF.exif_tag_get_name_in_ifd(self, ifd) : LibEXIF.exif_tag_get_name(self)
  end

  # Returns the localized title of the tag (i.e. `"F-Number"`).
  def title(ifd : LibEXIF::EXIFIfd? = nil) : String?
    ::EXIF.string? \
      ifd ? LibEXIF.exif_tag_get_title_in_ifd(self, ifd) : LibEXIF.exif_tag_get_title(self)
  end

  # Returns the localized description of the tag.
  def description(ifd : LibEXIF::EXIFIfd? = nil) : String?
    ::EXIF.string? \
      ifd ? LibEXIF.exif_tag_get_description_in_ifd(self, ifd) : LibEXIF.exif_tag_get_description(self)
  end

  # Returns the support level of the tag in the given *ifd*.
  def support_level(ifd : LibEXIF::EXIFIfd, data_type : LibEXIF::EXIFDataType = :unknown) : LibEXIF::EXIFSupportLevel
    LibEXIF.exif_tag_get_support_level_in_ifd(self, ifd, data_type)
  end

  # Returns `true` if the tag is known to be recorded in the given *ifd*.
  def known_in?(ifd : LibEXIF::EXIFIfd) : Bool
    !LibEXIF.exif_tag_get_name_in_ifd(self, ifd).null?
  end

  # Returns the IFD in which an entry of this tag should be created
  # (one of `lookup_ifds`), or `nil` for tags unknown to these.
  def default_ifd : LibEXIF::EXIFIfd?
    lookup_ifds.find { |ifd| known_in?(ifd) }
  end

  # Returns the IFDs in which entries of this tag are looked up, in order of priority.
  def lookup_ifds
    ::EXIF::TAG_LOOKUP_IFDS
  end

  # Returns the format of the tag defined by the specification, for tags
  # which libexif doesn't initialize with a default value, or `nil`.
  def spec_format : LibEXIF::EXIFFormat?
    ::EXIF::TAG_FORMATS[self]?
  end

  # Returns `true` if the tag is generated by libexif when saving the data,
  # and so can't be set (see `MANAGED_TAGS`).
  def managed? : Bool
    in?(::EXIF::MANAGED_TAGS)
  end

  # :nodoc:
  #
  # Raises `ArgumentError` if the tag is `managed?`.
  def check_settable : Nil
    return unless managed?

    if in?(JPEGInterchangeFormat, JPEGInterchangeFormatLength)
      hint = ", use `Data#thumbnail=` instead"
    end
    raise ArgumentError.new \
      "#{self} is generated by libexif when saving the data and can't be set#{hint}"
  end

  # Returns `true` if the tag can be stored either as `Format::Short`
  # or `Format::Long` (see `SHORT_OR_LONG_TAGS`).
  def short_or_long? : Bool
    in?(::EXIF::SHORT_OR_LONG_TAGS)
  end

  # Returns `self`.
  def to_tag : self
    self
  end
end

enum LibEXIF::EXIFGPSTag
  # Returns the tag with the given EXIF *name* (i.e. `"GPSLatitude"`), or `nil`.
  def self.from_name?(name : String) : self?
    ::EXIF.gps_tags_by_name[name]?
  end

  # Returns the tag with the given EXIF *name* (i.e. `"GPSLatitude"`).
  def self.from_name(name : String) : self
    from_name?(name) || raise ArgumentError.new("Unknown EXIF GPS tag: #{name.inspect}")
  end

  # Returns the EXIF name of the tag (i.e. `"GPSLatitude"`).
  def name : String?
    to_tag.name(:gps)
  end

  # Returns the localized title of the tag.
  def title : String?
    to_tag.title(:gps)
  end

  # Returns the localized description of the tag.
  def description : String?
    to_tag.description(:gps)
  end

  # Returns the support level of the tag in the GPS IFD.
  def support_level(data_type : LibEXIF::EXIFDataType = :unknown) : LibEXIF::EXIFSupportLevel
    to_tag.support_level(:gps, data_type)
  end

  # Returns `IFD::GPS`.
  def default_ifd : LibEXIF::EXIFIfd
    LibEXIF::EXIFIfd::GPS
  end

  # Returns the IFDs in which entries of this tag are looked up (`IFD::GPS`).
  def lookup_ifds
    {LibEXIF::EXIFIfd::GPS}
  end

  # Returns the format of the tag defined by the specification, for tags
  # which libexif doesn't initialize with a default value, or `nil`.
  def spec_format : LibEXIF::EXIFFormat?
    ::EXIF::GPS_TAG_FORMATS[self]?
  end

  # Returns the raw (numeric) `Tag` value, as used by libexif.
  def to_tag : LibEXIF::EXIFTag
    LibEXIF::EXIFTag.new(value)
  end
end
